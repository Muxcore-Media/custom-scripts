{
  "pkg": "media-ui",
  "globalName": "MediaUI",
  "shape": "package",
  "buildCmd": "npx vite build --config vite.config.lib.ts",
  "cssEntry": "src/index.css",
  "componentSrcMap": {
    "RouterWrapper": null,
    "Layout": "src/components/Layout.tsx",
    "MediaCard": "src/components/MediaCard.tsx",
    "VideoPlayer": "src/components/VideoPlayer.tsx",
    "Spinner": "src/components/Spinner.tsx",
    "Home": "src/pages/Home.tsx",
    "Movies": "src/pages/Movies.tsx",
    "MovieDetail": "src/pages/MovieDetail.tsx",
    "TVShows": "src/pages/TVShows.tsx",
    "TVShowDetail": "src/pages/TVShowDetail.tsx",
    "Player": "src/pages/Player.tsx"
  },
  "provider": {
    "component": "RouterWrapper",
    "props": {}
  },
  "previewArgs": {
    "Spinner": { "className": "w-10 h-10 text-purple-500" },
    "MediaCard": {
      "item": {
        "id": "1",
        "title": "Interstellar",
        "year": 2014,
        "overview": "A team of explorers travel through a wormhole in space.",
        "runtime": 169,
        "vote_average": 8.6,
        "genres": ["Science Fiction", "Adventure", "Drama"],
        "poster_url": "/api/images/movies/posters/interstellar.jpg",
        "has_file": true,
        "stream_url": "/stream/movies/1",
        "created_at": "2024-01-01T00:00:00Z"
      },
      "type": "movie"
    },
    "VideoPlayer": {
      "src": "/stream/movies/example",
      "title": "Example Movie"
    }
  }
}
